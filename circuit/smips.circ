    <comp name="Text" loc="(700,55)" lib="7">
      <a name="text" val="Lectura combinacional (RA1-&gt;RD1, RA2-&gt;RD2). Escritura de WD en WA en el flanco de subida de CLK si REG_WR=1." />
      <a name="font" val="SansSerif plain 12" />
